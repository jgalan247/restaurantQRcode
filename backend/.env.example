# App
APP_NAME="La Hacienda Ordering System"
APP_VERSION="1.0.0"
DEBUG=False

# Database
DATABASE_URL=postgresql+asyncpg://lahacienda:password123@localhost:5432/lahacienda

# Security
SECRET_KEY=your-super-secret-key-change-this-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# CityPay
CITYPAY_MERCHANT_ID=your_merchant_id
CITYPAY_API_KEY=your_api_key
CITYPAY_BASE_URL=https://api.citypay.com/v6

# Email
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_FROM=noreply@lahacienda.com
MAIL_PORT=587
MAIL_SERVER=smtp.gmail.com
MAIL_FROM_NAME=La Hacienda Restaurant

# Business Logic
GST_RATE=0.05
CURRENCY=USD
FRONTEND_URL=http://localhost:5173
