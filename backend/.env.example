# App Configuration
APP_NAME="La Hacienda Ordering System"
APP_VERSION="1.0.0"
DEBUG=False  # MUST be False in production!
ENVIRONMENT=development  # development, staging, production

# Database
# For local development:
DATABASE_URL=postgresql+asyncpg://lahacienda:YOUR_SECURE_PASSWORD@localhost:5432/lahacienda
# For Docker:
# DATABASE_URL=postgresql+asyncpg://lahacienda:YOUR_SECURE_PASSWORD@postgres:5432/lahacienda
# For Digital Ocean managed database:
# DATABASE_URL will be provided as DATABASE_URL environment variable

# Security - CRITICAL: Generate new secret for each environment!
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=CHANGE-THIS-TO-A-SECURE-RANDOM-STRING-MIN-64-CHARS
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS - Update with your production domain!
# Development:
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
# Production example:
# CORS_ORIGINS=["https://lahacienda.com","https://www.lahacienda.com"]

# CityPay Payment Gateway
# Get credentials from CityPay dashboard
CITYPAY_MERCHANT_ID=your_merchant_id_from_citypay
CITYPAY_API_KEY=your_api_key_from_citypay
CITYPAY_BASE_URL=https://api.citypay.com/v6
# For testing: Use CityPay sandbox URL
# CITYPAY_BASE_URL=https://sandbox.citypay.com/v6

# Email Service
# Option 1: Gmail (for testing only)
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_SERVER=smtp.gmail.com
# Option 2: SendGrid (recommended for production)
# MAIL_SERVER=smtp.sendgrid.net
# MAIL_USERNAME=apikey
# MAIL_PASSWORD=your_sendgrid_api_key
MAIL_FROM=noreply@lahacienda.com
MAIL_PORT=587
MAIL_FROM_NAME=La Hacienda Restaurant

# Business Logic
GST_RATE=0.05  # 5% tax
CURRENCY=GBP  # GBP, USD, EUR, etc.

# Frontend URL (for CORS and email links)
FRONTEND_URL=http://localhost:5173
# Production:
# FRONTEND_URL=https://lahacienda.com

# Restaurant Details (for invoices and receipts)
RESTAURANT_NAME="La Hacienda"
RESTAURANT_ADDRESS="123 Mexican Street, London, UK, SW1A 1AA"
RESTAURANT_PHONE="+44 20 1234 5678"
RESTAURANT_EMAIL="info@lahacienda.co.uk"
RESTAURANT_VAT_NUMBER="GB123456789"  # Leave empty if not VAT registered
